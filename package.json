{
  "name": "lanka-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2", "cookie-parser": "^1.4.7", "dotenv": "^16.6.1",
    "express": "^5.1.0", "express-rate-limit": "^8.0.1", "helmet": "^8.1.0",
    "lucide-react": "^0.468.0", "pg": "^8.16.3", "react": "^19.1.1",
    "react-dom": "^19.1.1", "react-router-dom": "^7.8.0", "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0", "@types/cookie-parser": "^1.4.9", "@types/express": "^5.0.3",
    "@types/node": "^22.17.2", "@types/pg": "^8.15.5", "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9", "@types/supertest": "^6.0.3", "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0", "embedded-postgres": "^17.5.0-beta.15", "supertest": "^7.1.4",
    "tsx": "^4.20.4", "typescript": "^5.9.2", "vite": "^6.3.5"
  }
}
